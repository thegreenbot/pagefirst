locals {
  bucket_name = "${var.name}-sites"
  worker_name = "${var.name}-sites"
  app_url     = "https://${var.app_domain}"
}

# Per-instance encryption key for stored Google refresh tokens (TOKEN_ENCRYPTION_KEY).
# It lives in Terraform state: keep the state private, and see
# runbooks/secret-rotation.md before changing it.
resource "random_bytes" "token_encryption_key" {
  length = 32
}

resource "neon_project" "db" {
  name                      = var.name
  region_id                 = var.neon_region
  pg_version                = var.neon_pg_version
  history_retention_seconds = 604800
}

resource "cloudflare_r2_bucket" "sites" {
  account_id    = var.cloudflare_account_id
  name          = local.bucket_name
  location      = var.r2_location
  storage_class = "Standard"
}

# Every site subdomain reaches the Worker. The app hostname stays a separate,
# DNS-only record pointing at Vercel (below), so it never passes through the Worker.
resource "cloudflare_dns_record" "sites_wildcard" {
  zone_id = var.cloudflare_zone_id
  name    = "*.${var.publish_domain}"
  type    = "AAAA"
  content = "100::"
  proxied = true
  ttl     = 1
  comment = "Pagefirst ${var.name}: published sites, served by the ${local.worker_name} Worker"
}

resource "vercel_project" "app" {
  name      = var.name
  framework = "nextjs"

  git_repository = {
    type              = "github"
    repo              = var.git_repository
    production_branch = var.git_ref
  }
}

resource "vercel_project_domain" "app" {
  project_id = vercel_project.app.id
  domain     = var.app_domain
}

locals {
  app_env_keys = toset([
    "APP_URL", "PUBLISH_DOMAIN", "CLOUDFLARE_ACCOUNT_ID", "R2_BUCKET", "PAGEFIRST_VERSION",
    "GOOGLE_CLIENT_ID", "AUDIT_ADMIN_EMAILS", "DATABASE_URL", "GOOGLE_CLIENT_SECRET",
    "R2_API_TOKEN", "TOKEN_ENCRYPTION_KEY",
  ])

  app_env = {
    APP_URL               = { value = local.app_url, sensitive = false }
    PUBLISH_DOMAIN        = { value = var.publish_domain, sensitive = false }
    CLOUDFLARE_ACCOUNT_ID = { value = var.cloudflare_account_id, sensitive = false }
    R2_BUCKET             = { value = cloudflare_r2_bucket.sites.name, sensitive = false }
    PAGEFIRST_VERSION     = { value = var.pagefirst_version, sensitive = false }
    GOOGLE_CLIENT_ID      = { value = var.google_client_id, sensitive = false }
    AUDIT_ADMIN_EMAILS    = { value = join(",", var.audit_admin_emails), sensitive = false }
    DATABASE_URL          = { value = neon_project.db.connection_uri, sensitive = true }
    GOOGLE_CLIENT_SECRET  = { value = var.google_client_secret, sensitive = true }
    R2_API_TOKEN          = { value = var.r2_api_token, sensitive = true }
    TOKEN_ENCRYPTION_KEY  = { value = random_bytes.token_encryption_key.base64, sensitive = true }
  }
}

resource "vercel_project_environment_variable" "app" {
  for_each = local.app_env_keys

  project_id = vercel_project.app.id
  key        = each.key
  value      = local.app_env[each.key].value
  target     = ["production"]
  sensitive  = local.app_env[each.key].sensitive
}

# The Worker is deployed with wrangler from the file this renders; see README.
resource "local_file" "wrangler" {
  filename = "${path.module}/.generated/wrangler.toml"
  content  = <<-EOT
    # Generated by infra/instance. Do not edit; change instance.auto.tfvars.json and re-apply.
    name = "${local.worker_name}"
    main = "../../../worker/index.ts"
    compatibility_date = "2026-11-01"
    workers_dev = false
    account_id = "${var.cloudflare_account_id}"

    [[r2_buckets]]
    binding = "SITES"
    bucket_name = "${cloudflare_r2_bucket.sites.name}"

    routes = [{ pattern = "*.${var.publish_domain}/*", zone_id = "${var.cloudflare_zone_id}" }]
  EOT
}
