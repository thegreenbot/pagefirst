{
  "name": "page-first",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3847 -H 127.0.0.1",
    "build": "next build --turbopack",
    "start": "next start -p 3847 -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 'lib/**/*.test.ts' 'enterprise/**/*.test.ts' && node --test scripts/git-flow.test.mjs scripts/instance-check.test.mjs",
    "test:coverage": "tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='lib/google/**' --test-coverage-include='lib/service/**' --test-coverage-include=lib/guard.ts --test-coverage-include='lib/http/**' --test-coverage-include=lib/page/validate.ts --test-coverage-include=lib/page/render.ts --test-coverage-include='lib/theme/**' --test-coverage-include=lib/site/theme-config.ts --test-coverage-include=lib/editor/preview-document.ts --test-coverage-include='lib/publish/**' --test-coverage-include='lib/db/**' --test-coverage-include='lib/auth/**' --test-coverage-include='lib/crypto/**' --test-coverage-include=lib/log.ts --test-coverage-include=lib/api-auth.ts --test-coverage-include='lib/oauth/**' --test-coverage-include='lib/tenant/**' --test-coverage-include='lib/api/**' --test-coverage-exclude=lib/db/test-db.ts --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=75 'lib/**/*.test.ts'",
    "test:http": "node --test --test-concurrency=1 tests/http/*.test.mjs",
    "test:e2e": "playwright test",
    "budgets": "tsx scripts/theme-budgets.ts",
    "budgets:lighthouse": "tsx scripts/theme-budgets.ts --lighthouse",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "ci": "node scripts/ci.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "liquidjs": "10.30.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "13.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
